# Copy to `.env` and fill in values. Never commit `.env`.

# --- Google Cloud / Vertex AI (Gemini via google-genai) ---
# Required for LLM calls. Authenticate with ADC on the host, e.g.:
#   gcloud auth application-default login
#
# Local venv: ADC is usually auto-discovered; you rarely need GOOGLE_APPLICATION_CREDENTIALS.
#
# Docker Compose: default mount is $HOME/.config/gcloud/application_default_credentials.json.
# Optional GCP_ADC_HOST_PATH=/path/on/host.json to override. Either omit GOOGLE_APPLICATION_CREDENTIALS
# here or set it exactly to: /secrets/application_default_credentials.json
# Never set GOOGLE_APPLICATION_CREDENTIALS to a host path (e.g. /Users/...) — Compose would pass
# that invalid path into the Linux container.
GOOGLE_CLOUD_PROJECT=

# Optional: override host path to ADC / SA JSON (default: $HOME/.config/gcloud/application_default_credentials.json)
# GCP_ADC_HOST_PATH=/path/to/credentials.json
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.0-flash
GOOGLE_GENAI_USE_VERTEXAI=true

# Phase 3 — NL→SQL (few-shot retrieval + routing on large manifests)
TEXT_EMBEDDING_MODEL=text-embedding-005
# NL_SQL_MAX_DETAILED_SCHEMA_TABLES=12
# NL_SQL_FEW_SHOT_COUNT=4
# NL_SQL_FULL_SCHEMA_TABLE_THRESHOLD=10

# --- PostgreSQL (SQLAlchemy URL) ---
# Local (venv): point at localhost. Compose overrides this for the `app` service.
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app

# --- Langfuse tracing ---
# Cloud: https://cloud.langfuse.com — set host + keys from project settings.
# Self-hosted (docker compose): app service uses LANGFUSE_HOST=http://lf-web:3000 automatically.
# Local venv + Langfuse in Docker: LANGFUSE_HOST=http://localhost:3000
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Optional Langfuse SDK (release grouping, env filter, trace version) — see README / .cursor/skills/langfuse
# LANGFUSE_RELEASE=
# LANGFUSE_TRACING_ENVIRONMENT=development
# LANGFUSE_TRACE_VERSION=1.0.0

# --- Langfuse self-hosted only (docker-compose.langfuse.yml; dev defaults) ---
# LLM-as-a-judge / Vertex from lf-web & lf-worker: same ADC mount as `app` (GCP_ADC_HOST_PATH).
# Set GOOGLE_CLOUD_PROJECT (and optional GOOGLE_CLOUD_LOCATION) in .env — see README Langfuse section.
# LANGFUSE_DB_PASSWORD=langfuse
# LANGFUSE_NEXTAUTH_SECRET=change-me
# LANGFUSE_SALT=change-me
# LANGFUSE_ENCRYPTION_KEY=   # 64 hex chars; openssl rand -hex 32
# REDIS_AUTH=devredissecret
# CLICKHOUSE_USER=clickhouse
# CLICKHOUSE_PASSWORD=clickhouse
# MINIO_ROOT_USER=minio
# MINIO_ROOT_PASSWORD=miniosecret
# NEXTAUTH_URL=http://localhost:3000
# Optional bootstrap: LANGFUSE_INIT_ORG_NAME, LANGFUSE_INIT_PROJECT_NAME, LANGFUSE_INIT_USER_EMAIL, etc.
