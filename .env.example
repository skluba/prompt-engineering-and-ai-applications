# Copy to `.env` and fill in values. Never commit `.env`.

# --- Google Cloud / Vertex AI (Gemini via google-genai) ---
# Required for LLM calls. Authenticate with ADC on the host, e.g.:
#   gcloud auth application-default login
# In Docker, mount a service account JSON and set:
#   GOOGLE_APPLICATION_CREDENTIALS=/path/inside/container/sa.json
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.0-flash
GOOGLE_GENAI_USE_VERTEXAI=true

# --- PostgreSQL (SQLAlchemy URL) ---
# Local (venv): point at localhost. Compose overrides this for the `app` service.
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app

# --- Langfuse (optional; omit to disable tracing) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Cloud EU default; use https://us.cloud.langfuse.com for US region
LANGFUSE_HOST=https://cloud.langfuse.com
